{
  "name": "mangodisk",
  "private": true,
  "version": "1.1.7",
  "author": {
    "name": "harry0703",
    "email": "harry0703@hotmail.com",
    "url": "https://github.com/harry0703"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://mangodisk.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harry0703/MangoDisk.git"
  },
  "bugs": {
    "url": "https://github.com/harry0703/MangoDisk/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm test && pnpm rust:test && pnpm build:frontend",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts vite.config.ts vitest.config.ts --max-warnings 0",
    "format": "prettier --write src scripts package.json pnpm-workspace.yaml tsconfig*.json vite.config.ts vitest.config.ts .prettierrc.json",
    "format:check": "prettier --check src scripts package.json pnpm-workspace.yaml tsconfig*.json vite.config.ts vitest.config.ts .prettierrc.json",
    "check:rule-sources": "node ./scripts/check-rule-sources.mjs",
    "check:source-language": "node ./scripts/check-source-language.mjs",
    "check:generated-ui": "node ./scripts/check-generated-ui-boundaries.mjs",
    "check:source-architecture": "node ./scripts/check-source-architecture.mjs",
    "check:style-system": "node ./scripts/check-style-system.mjs",
    "check:identity": "node ./scripts/check-product-identity.mjs",
    "check:i18n": "node ./scripts/check-i18n-usage.mjs",
    "check:frontend": "pnpm check:source-architecture && pnpm check:i18n && pnpm check:style-system && pnpm lint && pnpm format:check && pnpm test:coverage && pnpm build:frontend",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:check": "tauri build --no-bundle",
    "tauri:build:linux": "bash scripts/build-linux-bundles.sh",
    "cli:build": "cargo build --release -p mangodisk-cli",
    "cli:test": "cargo test -p mangodisk-cli",
    "baseline:cleanup": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --cleanup-baseline",
    "baseline:compare": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --compare-cleanup-baselines",
    "benchmark:dataset": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --generate-benchmark-dataset",
    "benchmark:engine": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --engine-benchmark",
    "benchmark:compare": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --compare-engine-benchmarks",
    "benchmark:application-uninstaller": "cargo run --manifest-path src-tauri/xtask/Cargo.toml --release -- --application-uninstall-benchmark --runs 6",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:check": "cargo check --workspace --all-targets",
    "check": "pnpm check:rule-sources && pnpm check:source-language && pnpm check:generated-ui && pnpm check:identity && pnpm check:frontend && pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:check && pnpm rust:test",
    "build:frontend": "vue-tsc --build --force && vite build && node ./scripts/check-build-output.mjs",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml -p mangodisk-core"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tabler/icons-vue": "3.49.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "~2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "simple-icons": "16.34.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@11.13.1"
}
